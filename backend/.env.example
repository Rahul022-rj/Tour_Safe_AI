# TourSafe AI backend configuration. Copy to backend/.env and adjust. NEVER commit backend/.env.
# Only JWT_SECRET is required; everything else has a development default.

# ---------- Core ----------
NODE_ENV=development
PORT=5000
# Use 127.0.0.1, not "localhost": on Windows "localhost" can resolve to IPv6 (::1) and MongoDB listens on IPv4 only
MONGODB_URI=mongodb://127.0.0.1:27017/tourist_safety
# Long random string (32+ characters required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session length; the user is logged out when it expires
JWT_EXPIRES_IN=8h
# The React app's URL (CORS allow-list and password-reset links)
CLIENT_URL=http://localhost:5173
# Extra allowed browser origins, comma separated (e.g. https://192.168.1.20:5173 for testing on a phone)
CORS_EXTRA_ORIGINS=
# Set to true behind a reverse proxy (nginx, load balancer) so rate limits use the real client IP
TRUST_PROXY=false
BCRYPT_ROUNDS=12
PASSWORD_RESET_MINUTES=30

# ---------- Blockchain ----------
# Local development: "npm run chain" starts Hardhat on this URL (chain 31337, IN MEMORY, erased on restart)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Leave empty to read the address from blockchain/deployment.json (written by "npm run chain:deploy")
CONTRACT_ADDRESS=
# Owner key that signs transactions. Leave EMPTY for the local Hardhat chain (its unlocked account #0 is used).
# Required for any other network. Never commit a real key.
PRIVATE_KEY=
CHAIN_CONFIRMATIONS=1
CHAIN_TX_TIMEOUT_MS=60000
CHAIN_RETRY_INTERVAL_MS=30000
CHAIN_MAX_ATTEMPTS=10
# true = a Digital ID is only reported VALID after its on-chain registration is confirmed (recommended)
REQUIRE_CHAIN_FOR_ID=true

# ---------- Tracking, geofencing, anomaly detection ----------
LOCATION_RETENTION_DAYS=30
MIN_LOCATION_INTERVAL_MS=2000
# Readings less accurate than this (metres) never trigger zone alerts
GEOFENCE_MAX_ACCURACY_M=100
STALE_AFTER_MS=60000
OFFLINE_AFTER_MS=600000
SOS_COOLDOWN_MS=30000
ANOMALY_MAX_SPEED_KMH=200
ANOMALY_INACTIVITY_MIN=30
ANOMALY_RESTRICTED_DWELL_MIN=10
ANOMALY_SWEEP_MS=60000

# ---------- Safety tools (check-in timer, journey monitoring) ----------
# Metres from the planned route that count as off-route, and how many consecutive accurate readings trigger a review alert
ROUTE_DEVIATION_M=150
ROUTE_DEVIATION_READINGS=3
# Within this distance (m) of the destination the journey ends as "arrived"
ARRIVAL_RADIUS_M=60
# Minutes after the expected arrival (at least; or 50% of the planned duration if longer) before "overdue"
JOURNEY_OVERDUE_GRACE_MIN=15
# How often missed check-ins and overdue journeys are checked (ms)
SAFETY_SWEEP_MS=30000

# ---------- Email (any SMTP provider, e.g. Gmail app password, SendGrid, Mailgun, Amazon SES SMTP) ----------
# Without SMTP_HOST and EMAIL_FROM, emails are recorded as "not_configured" and never reported as sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Same alert to the same recipient at most once per window (ms)
NOTIFY_COOLDOWN_MS=600000

# ---------- SMS (Twilio) ----------
# Without these, SMS are recorded as "not_configured".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Maps (OpenStreetMap-based public services; respect their usage policies) ----------
OSRM_URL=https://routing.openstreetmap.de
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Identifies the app to those services (do not put personal data here)
EXTERNAL_USER_AGENT=TourSafe-AI/1.0 (tourist safety research project)
DISABLE_EXTERNAL_APIS=false
